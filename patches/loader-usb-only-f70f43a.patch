+static int join_path(char *dst, const char *dir, const char *name)
+{
+    unsigned long long n = 0;
+
+    for (; dir[n]; n++) {
+        if (n + 1 >= BOOT_PATH_MAX)
+            return -1;
+        dst[n] = dir[n];
+    }
+    for (unsigned long long i = 0; name[i]; i++, n++) {
+        if (n + 1 >= BOOT_PATH_MAX)
+            return -1;
+        dst[n] = name[i];
+    }
+    dst[n] = '\0';
+    return 0;
+}
+
+static int file_readable(const char *dir, const char *name)
+{
+    char path[BOOT_PATH_MAX];
+    int fd;
+
+    if (join_path(path, dir, name))
+        return 0;
+    fd = open(path, O_RDONLY);
+    if (fd < 0)
+        return 0;
+    close(fd);
+    return 1;
+}
+
+/* Devuelve la primera carpeta USB que contiene AMBOS archivos obligatorios. */
+static const char *select_usb_boot_dir(void)
+{
+    const char *dirs[] = { USB_BOOT_DIR_0, USB_BOOT_DIR_1 };
+
+    for (int i = 0; i < 2; i++)
+        if (file_readable(dirs[i], "bzImage") &&
+            file_readable(dirs[i], "initramfs.cpio.gz"))
+            return dirs[i];
+    return (const char *)0;
+}
+
+static int load_from(const char *dir, const char *name, char **ptr,
+                     unsigned long long *sz)
+{
+    char path[BOOT_PATH_MAX];
+
+    if (join_path(path, dir, name))
+        return -1;
+    return read_file(path, ptr, sz);
+}
